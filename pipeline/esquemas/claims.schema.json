{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "claims.json: toda afirmación comprobable de un guion",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "tipo", "nota"],
    "properties": {
      "id": {"type": "string", "pattern": "^c[0-9]{2,3}$"},
      "tipo": {"enum": ["numero", "simbolico", "ecuacion", "unidades", "codigo", "dato"]},
      "nota": {"type": "string", "description": "Qué dice el guion, en palabras"},
      "escena": {"type": "string"},
      "expr": {"type": "string"},
      "esperado": {"type": "string"},
      "decimales": {"type": "integer", "minimum": 0, "description": "numero: el guion redondea a estos decimales"},
      "ecuacion": {"type": "string", "description": "ecuacion: 'lado_izq = lado_der'"},
      "incognita": {"type": "string"},
      "soluciones": {"type": "array", "items": {"type": "string"}},
      "dominio": {"enum": ["reales", "enteros", "naturales", "complejos"]},
      "lenguaje": {"enum": ["python"]},
      "codigo": {"type": "string"},
      "salida": {"type": "string", "description": "codigo: salida estándar esperada (sin espacios finales)"},
      "fuente": {"type": "string", "description": "dato: URL o referencia comprobable"},
      "estado": {"enum": ["a_verificar", "verificado"]}
    },
    "allOf": [
      {"if": {"properties": {"tipo": {"enum": ["numero", "simbolico", "unidades"]}}},
       "then": {"required": ["expr", "esperado"]}},
      {"if": {"properties": {"tipo": {"const": "ecuacion"}}},
       "then": {"required": ["ecuacion", "incognita", "soluciones"]}},
      {"if": {"properties": {"tipo": {"const": "codigo"}}},
       "then": {"required": ["lenguaje", "codigo", "salida"]}},
      {"if": {"properties": {"tipo": {"const": "dato"}}},
       "then": {"required": ["fuente", "estado"]}}
    ]
  }
}
