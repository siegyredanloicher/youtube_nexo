{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "escenas.json: el plan visual de un episodio (lo escribe director-visual)",
  "type": "object",
  "required": ["id", "idioma", "nivel", "terminos", "escenas"],
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Z]{2,4}-[A-Z0-9]+-[A-Z]?[0-9]+(\\.[0-9]+)?$"},
    "idioma": {"enum": ["es", "en"]},
    "nivel": {"enum": ["eso", "bach", "uni", "avanzado"]},
    "terminos": {
      "type": "object",
      "description": "Color fijo de cada término de las fórmulas en TODO el vídeo: {'x': 'mates.a'}",
      "additionalProperties": {"enum": ["mates.a", "mates.b", "mates.c", "mates.d"]}
    },
    "escenas": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/escena"}}
  },
  "$defs": {
    "escena": {
      "type": "object",
      "required": ["id", "seccion", "locucion", "duracion_s", "capas"],
      "properties": {
        "id": {"type": "string", "pattern": "^e[0-9]{2}$"},
        "seccion": {"enum": ["gancho", "problema", "origen", "regla", "ejemplo", "vida_real", "inverso",
                              "error_comun", "demostracion", "codigo", "practica", "resumen", "siguiente"]},
        "locucion": {"type": "string", "minLength": 1},
        "duracion_s": {"type": "number", "minimum": 1, "description": "Estimada; el editor usa la del audio real"},
        "claims": {"type": "array", "items": {"type": "string", "pattern": "^c[0-9]{2,3}$"}},
        "capas": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/capa"}},
        "notas": {"type": "string"}
      }
    },
    "capa": {
      "type": "object",
      "required": ["tipo"],
      "properties": {
        "tipo": {"enum": ["fondo", "2d", "nexo", "texto", "media"]},
        "zona": {"enum": ["completa", "izquierda", "derecha", "centro", "abajo", "esquina"]},
        "entra_s": {"type": "number", "minimum": 0},
        "sale_s": {"type": "number", "minimum": 0}
      },
      "allOf": [
        {"if": {"properties": {"tipo": {"const": "fondo"}}},
         "then": {"required": ["color"], "properties": {"color": {"enum": ["fondo.base", "fondo.alt", "fondo.superficie", "fondo.oscuro"]}}}},
        {"if": {"properties": {"tipo": {"const": "2d"}}},
         "then": {"required": ["descripcion", "componentes"],
                  "properties": {"descripcion": {"type": "string"},
                                 "componentes": {"type": "array", "items": {"type": "string"}},
                                 "clase": {"type": "string", "description": "La pone animador-2d: clase Manim que la implementa"}}}},
        {"if": {"properties": {"tipo": {"const": "nexo"}}},
         "then": {"required": ["plano"], "properties": {"plano": {"$ref": "#/$defs/plano"}}}},
        {"if": {"properties": {"tipo": {"const": "texto"}}},
         "then": {"required": ["texto", "estilo"],
                  "properties": {"texto": {"type": "string"}, "estilo": {"enum": ["titulo", "subtitulo", "cuerpo", "pie", "formula"]}}}},
        {"if": {"properties": {"tipo": {"const": "media"}}},
         "then": {"required": ["ruta", "licencia"]}}
      ]
    },
    "plano": {
      "type": "object",
      "description": "Un plano de Nexo; lo renderiza pipeline/render_nexo.py",
      "required": ["accion", "duracion_s"],
      "properties": {
        "accion": {"type": "string", "description": "Nombre de nexo/acciones.py (ver catálogo)"},
        "params": {"type": "object"},
        "props": {"type": "array", "items": {
          "type": "object", "required": ["id", "prop"],
          "properties": {"id": {"type": "string"}, "prop": {"type": "string"},
                         "en": {"type": "string", "description": "mano.L | mano.R | suelo | [x, y, z] en metros"},
                         "escala": {"type": "number"}}}},
        "expresiones": {"type": "array", "items": {
          "type": "object", "required": ["t", "nombre"],
          "properties": {"t": {"type": "number", "minimum": 0},
                         "nombre": {"enum": ["Neutro", "Feliz", "Tranquilo", "Sorpresa", "Pensativo", "Concentrado",
                                             "Curioso", "Motivado", "Entusiasmado", "Parpadeo"]},
                         "valor": {"type": "number", "minimum": 0, "maximum": 1}}}},
        "camara": {"enum": ["completo", "medio", "primer_plano", "tres_cuartos", "lateral", "picado"]},
        "encuadre": {"enum": ["centro", "izquierda", "derecha"]},
        "entorno": {"type": "string", "description": "transparente (por defecto) | estudio | nombre de escenario"},
        "duracion_s": {"type": "number", "minimum": 0.5},
        "fps": {"type": "integer"}
      }
    }
  }
}
